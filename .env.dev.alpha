# config
APP_NAME=orch-business-external
APP_PORT=8080
APP_ENV_STAGE=LOCAL

LOG_LEVEL=DEBUG
LOG_MASK_SENSITIVE_DATA=true

API_CORE_BUSINESS_SERVER_PATH=/v1/create
API_CORE_BUSINESS_SERVER_MAX_CONNS=10
API_CORE_BUSINESS_SERVER_MAX_RETRY=0
API_CORE_BUSINESS_SERVER_TIMEOUT=10s
API_CORE_BUSINESS_SERVER_INSECURE_SKIP_VERIFY=true

REDIS_TIMEOUT=10s
REDIS_MAX_RETRY=3
REDIS_POOL_SIZE=10
REDIS_DB=0
REDIS_KEY_USER_VERIFIED_ACCOUNT=USER-VERIFIED-ACCOUNT

# secret
API_CORE_BUSINESS_SERVER_BASE_URL=http://host.docker.internal:1324
